# Configuration de la base de données
# Pour dev local avec docker-compose: DB_HOST=localhost
# Pour dev avec backend dans Docker: DB_HOST=mysql
DB_HOST=localhost
DB_USER=olivier
DB_PASSWORD=olivier
DB_NAME=skyjo
DB_PORT=3306
# Utilisé seulement par docker-compose pour le compte root de MySQL
DB_ROOT_PASSWORD=root

# Better Auth : secret de signature des sessions (32+ caractères aléatoires, obligatoire)
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=secret-de-dev-a-remplacer-par-32-caracteres

# Connexion Google (optionnelle en dev : sans ces valeurs, seul l'email + mot de passe fonctionne)
# Google Cloud Console > API et services > Identifiants > ID client OAuth (application Web)
#   Origine JavaScript autorisée : FRONTEND_HOST (ex. http://localhost:5173)
#   URI de redirection autorisée : APP_URL + /api/auth/callback/google (ex. http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL de l'application backend (utilisée pour les logs et la documentation)
# Exemples:
#   - Local: http://localhost:3000
#   - Production: https://api.labodolivier.com
APP_URL=http://localhost:3000

# Configuration serveur
PORT=3000
NODE_ENV=development

# URL du frontend (pour CORS)
# Exemples:
#   - Local: http://localhost:5173
#   - Production: https://labodolivier.com
FRONTEND_HOST=http://localhost:5173

# Envoi de mail
# Dev / recette : Mailpit (docker compose), interface sur http://localhost:8025
#   En recette, SMTP_HOST = nom du service Mailpit dans Dokploy
# Production : laisser SMTP_HOST vide pour utiliser le compte Gmail ci-dessous
SMTP_HOST=localhost
SMTP_PORT=1025
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD="gmail app password"
GMAIL_APP_EMAIL="gmail email account"
